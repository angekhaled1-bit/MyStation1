MQTT_URL=mqtt://localhost:1883
PORT=4000
CORS_ORIGINS=http://localhost:3000
# Jetons provisoires : jeton=utilisateur@client:rôle (operator, approver, admin, superadmin)
# API_TOKENS=...
COMMAND_TTL_HOURS=24
COMMAND_RETRY_SECONDS=60
GATEWAY_OFFLINE_MINUTES=10

# Simulateur de boîtier (une instance par boîtier)
GW_ID=gw-0007
GW_SECRET=dev-secret-gw-0007
TENANT=afriquia
PRICE_MIN=500
PRICE_MAX=1500
SIM_PUMPS=2
SIM_DEAD_PUMPS=
