{
  "name": "@fpc/gateway-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Logiciel du boîtier passerelle, avec équipements simulés (totem, pompes) et broker MQTT de développement.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --import tsx src/main.ts",
    "broker": "node --import tsx src/broker.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": { "@fpc/protocol": "0.1.0", "mqtt": "^5.16.1", "aedes": "^1.2.0" },
  "devDependencies": { "typescript": "~5.9.3", "tsx": "^4.23.15", "@types/node": "^22.0.0" }
}
